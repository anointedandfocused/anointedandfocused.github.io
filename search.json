---
layout: null
permalink: /search.json
---
[
{%- for post in site.posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "category": {{ post.categories | first | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "type": {{ post.type | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | strip | truncate: 220 | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncate: 2000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
